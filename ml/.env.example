# ============================================================================
# WhatsApp Alert Configuration for IoE Fall Detection System
# Copy this file to `ml/.env` and fill in the credentials for your chosen provider.
# ============================================================================

# Enable or disable WhatsApp alerts globally (true / false)
WHATSAPP_ENABLED=true

# Provider selection: "callmebot" (simplest free demo), "twilio", or "meta"
WHATSAPP_PROVIDER=callmebot

# Alert trigger mode:
#   "hybrid"       - (Recommended) Sends WhatsApp when ESP32 publishes FALL_ALERT
#                    (after 8s grace period without cancel, or on Manual SOS hold)
#                    and includes the Random Forest ML confirmation status.
#   "ml_strict"    - Sends WhatsApp for sensor falls ONLY when BOTH the 8s grace
#                    period expires AND the ML model confirmed the fall (Manual SOS
#                    always sends).
#   "ml_immediate" - Sends WhatsApp immediately when ML confirms a fall window.
WHATSAPP_ALERT_MODE=hybrid

# Cooldown in seconds between WhatsApp messages per device to prevent spam
WHATSAPP_COOLDOWN_SECONDS=30

# ----------------------------------------------------------------------------
# Option A: CallMeBot (Free, 1-Minute Setup for Personal/Demo WhatsApp)
# 1. Add +34 644 71 81 99 (or current number at https://www.callmebot.com/blog/free-api-whatsapp-messages/)
#    to your phone contacts.
# 2. Send the WhatsApp message: "I allow callmebot to send me messages"
# 3. Paste your phone number (with country code, e.g., +919876543210) and the API key below:
# ----------------------------------------------------------------------------
CALLMEBOT_PHONE=+919136669616
CALLMEBOT_API_KEY=your_callmebot_api_key

# ----------------------------------------------------------------------------
# Option B: Twilio WhatsApp Sandbox (Supports Multiple Caregiver Numbers)
# 1. Sign up for a free Twilio trial and open Messaging -> Try it out -> Send a WhatsApp message.
# 2. Join the sandbox from caregiver phone(s) and set the values below:
# ----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Comma-separated list of recipient numbers (with country code):
CAREGIVER_WHATSAPP_TO=+919136669616

# ----------------------------------------------------------------------------
# Option C: Meta Official WhatsApp Cloud API
# ----------------------------------------------------------------------------
META_ACCESS_TOKEN=your_meta_graph_api_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
